# Normalize line endings: store LF in repo, checkout as native (CRLF on Windows)
* text=auto

# Source and config files: always LF
*.cpp   text eol=lf
*.h     text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Binary assets: never touch
*.png   binary
*.jpg   binary
*.wav   binary
*.ttf   binary
*.otf   binary

# Archivos que se ejecutan dentro de Linux (Docker): siempre LF,
# aunque el repo se clone en Windows con core.autocrlf=true.
*.sh          text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf

# Scripts de Windows: CRLF
*.ps1         text eol=crlf

# Normalize line endings: store LF in repo, checkout as native (CRLF on Windows)
* text=auto

# Source and config files: always LF
*.cpp   text eol=lf
*.h     text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Binary assets: never touch
*.png   binary
*.jpg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
